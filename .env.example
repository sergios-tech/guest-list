# Copy to .env and adjust as needed. docker compose auto-loads .env from this directory.
# All variables have safe defaults in docker-compose.yml — overrides here win.

# ---------------------------------------------------------------------------
# Postgres (db service)
# ---------------------------------------------------------------------------
# These also feed the API's DATABASE_URL, so keep them as the single source of
# truth for credentials. The init scripts in db/ only run on an empty volume —
# changing the password after first boot requires `docker compose down -v`.
POSTGRES_DB=guests
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=db_p@$$W0rd_CHANGE_ME

# ---------------------------------------------------------------------------
# API (api service)
# ---------------------------------------------------------------------------
# Used to sign and verify JWTs. REQUIRED — no default. The api process refuses
# to boot if this is unset or shorter than 32 characters (api/src/config/jwt.config.ts).
# Generate a strong value with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-openssl-rand-base64-48-output

# Token lifetime. Accepts ms-style strings (e.g. "12h", "30m", "7d").
JWT_EXPIRES_IN=12h

# ---------------------------------------------------------------------------
# Ingress (nginx service)
# ---------------------------------------------------------------------------
# Host port for the public entrypoint. Change if 8080 is already taken.
WEB_PORT=8080
