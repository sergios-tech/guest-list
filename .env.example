# Copy to .env and adjust as needed. docker compose auto-loads .env from this directory.
# All variables have safe defaults in docker-compose.yml — overrides here win.

# ---------------------------------------------------------------------------
# Postgres (db service)
# ---------------------------------------------------------------------------
# These also feed the API's DB_* connection vars, so keep them as the single
# source of truth for credentials. The init scripts in db/ only run on an
# empty volume — changing the password after first boot requires
# `docker compose down -v`.
#
# POSTGRES_PASSWORD has no default in docker-compose.yml — compose refuses to
# boot unless it's set here. Generate a strong value with:
#   openssl rand -base64 24
POSTGRES_DB=guests
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=replace-me-with-openssl-rand-base64-24-output

# ---------------------------------------------------------------------------
# API (api service)
# ---------------------------------------------------------------------------
# Used to sign and verify JWTs. REQUIRED — no default. The api process refuses
# to boot if this is unset or shorter than 32 characters (api/src/config/jwt.config.ts).
# Generate a strong value with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-openssl-rand-base64-48-output

# Token lifetime. Accepts ms-style strings (e.g. "12h", "30m", "7d").
JWT_EXPIRES_IN=12h

# Comma-separated origin allowlist for cross-origin browser requests. Set to
# the public URL(s) of the SPA in production; same-origin traffic through the
# bundled nginx does not need to be listed.
# CORS_ORIGINS=https://guests.example.com,https://www.guests.example.com

# Optional: managed Postgres usually requires TLS.
# DATABASE_SSL=require
# DATABASE_CA=

# Optional pool tuning. Default is 20 connections per api replica.
# DB_POOL_MAX=20

# ---------------------------------------------------------------------------
# Ingress (nginx service)
# ---------------------------------------------------------------------------
# Host port for the public entrypoint. Change if 8080 is already taken.
WEB_PORT=8080
