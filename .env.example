# Copy to .env and adjust as needed. docker compose auto-loads .env from this directory.
# All variables have safe defaults in docker-compose.yml — overrides here win.

# ---------------------------------------------------------------------------
# Postgres (db service)
# ---------------------------------------------------------------------------
# These also feed the API's DB_* connection vars, so keep them as the single
# source of truth for credentials. The init scripts in db/ only run on an
# empty volume — changing the password after first boot requires
# `docker compose down -v`.
#
# POSTGRES_PASSWORD has no default in docker-compose.yml — compose refuses to
# boot unless it's set here. Generate a strong value with:
#   openssl rand -base64 24
POSTGRES_DB=guests
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=replace-me-with-openssl-rand-base64-24-output

# ---------------------------------------------------------------------------
# API (api service)
# ---------------------------------------------------------------------------
# Used to sign and verify JWTs. REQUIRED — no default. The api process refuses
# to boot if this is unset or shorter than 32 characters (api/src/config/jwt.config.ts).
# Generate a strong value with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-openssl-rand-base64-48-output

# Token lifetime. Accepts ms-style strings (e.g. "12h", "30m", "7d").
JWT_EXPIRES_IN=12h

# Comma-separated origin allowlist for cross-origin browser requests. Set to
# the public URL(s) of the SPA in production; same-origin traffic through the
# bundled nginx does not need to be listed.
CORS_ORIGINS=https://guests.example.com

# Optional: managed Postgres usually requires TLS.
# DATABASE_SSL=require
# DATABASE_CA=

# Optional pool tuning. Default is 20 connections per api replica.
# DB_POOL_MAX=20

# ---------------------------------------------------------------------------
# Ingress
# ---------------------------------------------------------------------------
# In production the guest-list nginx joins the external `sergio-tech_proxy`
# network and is reached via the sergio-tech nginx-proxy — no host port.
# For local laptop dev, either create that network as a stub
#   docker network create sergio-tech_proxy
# or add a temporary `ports: ["8080:80"]` block to the nginx service.

# ---------------------------------------------------------------------------
# Google Sheets sync (Dashboard "Sync from Google Sheet" button)
# ---------------------------------------------------------------------------
# OAuth client from Google Cloud Console:
#   APIs & Services → Credentials → Create credentials → OAuth client ID
#   → Web application. Authorized redirect URIs must include BOTH:
#     http://localhost:8080/api/google-sync/oauth/callback   (dev)
#     https://guests.sergiotech.com/api/google-sync/oauth/callback   (prod)
# Also enable the Google Sheets API on the same project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# REQUIRED in prod. Must exactly match one of the Authorized redirect URIs above.
GOOGLE_OAUTH_REDIRECT_URI=https://guests.sergiotech.com/api/google-sync/oauth/callback

# AES-256-GCM key for encrypting stored Google refresh tokens. REQUIRED.
# Generate with: openssl rand -hex 32  (must be exactly 64 hex chars).
# Rotating this key invalidates every stored Google connection — users
# have to reconnect via the Dashboard.
GOOGLE_TOKEN_ENC_KEY=

# The sheet to sync from. Defaults to the production wedding sheet.
# GOOGLE_SHEET_ID=1gsydyLPpQH3bJoppdZoLYjlq3zKexlc-qWnuYnujeQM
# GOOGLE_SHEET_TAB=Pozivnice
